# Copia questo file in .env e inserisci il tuo token:
#   cp .env.example .env
#
# Crea il token su GitHub:
#   Settings → Developer settings → Personal access tokens
# Scope consigliati: repo
#
# NON condividere il token in chat e NON commitare .env

GITHUB_TOKEN=ghp_il_tuo_nuovo_token_qui
GITHUB_REPO=teologuida/fondamenti-della-fede
s